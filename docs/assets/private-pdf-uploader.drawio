        <mxCell id="title" value="&lt;b&gt;Private PDF corpus uploader&lt;/b&gt;" style="text;html=1;align=left;fontSize=28;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="A public HTTPS upload surface; private, managed-identity writes to Blob Storage. No workstation-to-Storage VPN dependency." style="text;html=1;align=left;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1400" height="30" as="geometry"/></mxCell>
