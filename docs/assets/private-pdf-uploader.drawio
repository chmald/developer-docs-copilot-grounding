        <mxCell id="blob-edge" value="Private HTTPS" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#036C70;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="endpoint" target="blob"><mxGeometry relative="1" as="geometry"/></mxCell>
